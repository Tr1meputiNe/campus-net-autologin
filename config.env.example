# 复制成 config.env 后填写：  cp config.env.example config.env && chmod 600 config.env
# config.env 含密码，权限保持 600，并确保它被 .gitignore 排除，不要提交。

IFACE=en1

# ── 账号 ──────────────────────────────────────────────────────
# 很多学校要求带运营商后缀，例如 2025001@cmcc / @dx / @lt
CAMPUS_USER="你的学号"
CAMPUS_PASS="你的密码"

# ── 认证方式（四选一）──────────────────────────────────────────
# eportal  Dr.COM / 锐捷 eportal JSONP 接口
# curl     逐字重放 DevTools 里 Copy as cURL 的请求（其它厂商用这个最稳）
# form     普通表单 POST
# open     不自动提交，只把登录页弹出来
LOGIN_MODE=eportal

# ── [eportal] Dr.COM / 锐捷 ───────────────────────────────────
# 掉线时浏览器跳到的登录页那个 IP，就是 PORTAL_HOST
# 接口： GET {EPORTAL_BASE}/portal/login
PORTAL_HOST="10.x.x.x"
PORTAL_URL="http://10.x.x.x/"
EPORTAL_BASE="http://10.x.x.x:801/eportal"
EPORTAL_MAC="000000000000"      # 认证时上报的 MAC，标准做法是全 0

# ── [form] 普通表单 ───────────────────────────────────────────
PORTAL_LOGIN_URL=""
PORTAL_USER_FIELD="username"    # 表单里账号字段名
PORTAL_PASS_FIELD="password"    # 表单里密码字段名
PORTAL_EXTRA_FIELDS=""          # 其它固定字段，如 "domain=1&login_method=1"

# ── [curl] 从 DevTools → Network → 选中登录请求 → 右键 Copy as cURL ──
# 把明文账号密码换成 $CAMPUS_USER / $CAMPUS_PASS 占位符即可
LOGIN_CURL=""

# ── 日志心跳间隔（秒，可选）────────────────────────────────────
# 状态没变化时，最多这么久写一条"我还活着"的记录。默认 1800（30 分钟）。
# 关心磁盘写入可以调大，例如 86400 = 每天只写 1 行。
# HEARTBEAT_SEC=1800

# ── 日志保留天数（可选）──────────────────────────────────────
# 超过这个天数的日志行会被自动清除。默认 90（约三个月）。
# 轮转每天最多执行一次，由 portal-login.sh 自动触发，不需要额外任务。
# RETAIN_DAYS=90

# ── 探活端点 ──────────────────────────────────────────────────
# 用 IP 直连，绕开隧道/代理的 DNS 劫持（fake-ip）导致的误判
ONLINE_PROBES="http://223.5.5.5/ http://1.1.1.1/ http://114.114.114.114/"
