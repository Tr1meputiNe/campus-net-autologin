<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.campusnet.auth</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__INSTALL_DIR__/scripts/portal-login.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CAMPUS_HOME</key>
        <string>__INSTALL_DIR__</string>
        <key>LOG_DIR</key>
        <string>__LOG_DIR__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 登录后立即查一次，之后每 2 分钟查一次 -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>__START_INTERVAL__</integer>

    <!-- 网络配置变化时立刻触发（切 Wi-Fi / 插拔网线 / 重新拿 IP） -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration/NetworkInterfaces.plist</string>
        <string>/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist</string>
        <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>__THROTTLE__</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/launchd.err.log</string>
</dict>
</plist>
